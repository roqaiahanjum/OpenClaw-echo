{
  "name": "open-claw-echo",
  "version": "1.0.0",
  "description": "Local-first AI agent framework",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/kill-port.js",
    "dev": "nodemon src/index.ts",
    "build:dashboard": "cd dashboard && npm install --include=dev && npm run build",
    "build:server": "tsc",
    "build": "npm run build:dashboard && npm run build:server",
    "prestart": "node scripts/prestart_restore.js",
    "start": "node dist/index.js",
    "start:bg": "node dist/index.js >> logs/openclaw.log 2>&1",
    "start:dev": "node -r ts-node/register src/index.ts",
    "start:ts": "ts-node --transpile-only src/index.ts",
    "lint": "echo Lint skipped - ts-nocheck active on tools.ts",
    "test": "jest",
    "test:tools": "npx ts-node --transpile-only scratch/test_all_tools.ts",
    "eval": "npx ts-node scratch/eval_metrics.ts",
    "rebuild:sqlite": "npm rebuild sqlite3 --build-from-source",
    "auth:generate-hash": "ts-node --transpile-only scripts/generate_access_hash.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "local-first",
    "langchain"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/classic": "^1.0.31",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^1.5.0",
    "nodemailer": "^10.3.1",
    "simple-git": "^4.0.2",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "docx": "^9.6.1",
    "jest": "^30.3.0",
    "node-gyp": "^12.2.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
