# Google Gemini API Key
GOOGLE_API_KEY=

# Groq API Key (Fast Failover Provider)
GROQ_API_KEY=

# Telegram Bot Token
TELEGRAM_TOKEN=
TELEGRAM_MODE=polling

# Tavily Search API Key
TAVILY_API_KEY=

# Ollama Local Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Server Port
PORT=3005
