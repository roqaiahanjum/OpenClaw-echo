# ==============================================================================
# OpenClaw Echo — Production & Local Environment Configuration
# ==============================================================================
# Safe placeholder template. NEVER commit actual production secrets to Git.

# ------------------------------------------------------------------------------
# 1. CORE AI PROVIDERS (Required)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for multi-agent reasoning, intent routing, and embeddings)
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Optional alias:
# GEMINI_API_KEY=your_google_gemini_api_key_here

# Groq API Key (High-speed Llama-3 failover & tool execution router)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT & DEMO AUTHENTICATION
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram Mode: 'polling' (Recommended for stability & demos) or 'webhook' or 'disabled'
TELEGRAM_MODE=polling

# Demo Access Code Salted Hash: <salt_hex>:<pbkdf2_sha512_hash_hex>
# Generate a hash using: npx ts-node -e "import { createSaltedHash } from './src/core/auth'; console.log(createSaltedHash('YourAccessCode'));"
DEMO_ACCESS_CODE_HASH=your_salted_hash_here

# Administrator Telegram User ID(s) (comma-separated for multiple admins)
# Admins bypass access codes and can revoke users using /revoke <telegram_user_id>
ADMIN_TELEGRAM_ID=your_telegram_user_id_here

# Telegram Webhook Base URL (Only required if TELEGRAM_MODE=webhook and not on Render)
# On Render, RENDER_EXTERNAL_URL is automatically detected.
# TELEGRAM_WEBHOOK_URL=https://openclaw-echo.onrender.com

# ------------------------------------------------------------------------------
# 3. HTTP SERVER & DEPLOYMENT
# ------------------------------------------------------------------------------
# Port for Express API, React Dashboard, and Telemetry SSE
# On Render / Railway, PORT is automatically injected by the platform.
PORT=3005
NODE_ENV=production

# ------------------------------------------------------------------------------
# 4. EXTERNAL TOOLS & WEB SEARCH (Optional)
# ------------------------------------------------------------------------------
# Tavily API Key for live web scraping and search agent
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL AUTOMATION (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# ------------------------------------------------------------------------------
# 6. STORAGE & PERSISTENCE (Optional overrides)
# ------------------------------------------------------------------------------
# Base data directory (e.g. for Render/Railway persistent volume mount)
# OPENCLAW_DATA_DIR=/app/data
# Explicit paths (defaults to cwd or OPENCLAW_DATA_DIR if unset):
# SQLITE_DB_PATH=./openclaw.db
# SEMANTIC_CORE_PATH=./src/memory/semantic_core.json
# SANDBOX_DIR=./src/sandbox
